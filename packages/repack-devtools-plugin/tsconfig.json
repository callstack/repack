{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // `rozenite build` emits the CommonJS entry with `moduleResolution: node10`,
    // which ignores package exports. React Native >= 0.87 only declares its
    // types through exports, so point node10 at them directly.
    "paths": {
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "react-native.ts",
    "sdk.ts",
    "rozenite.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/bundler"]
}
