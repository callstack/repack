{
  "manifestVersion": 1,
  "id": "store",
  "name": "store",
  "metaData": {
    "name": "store",
    "globalName": "store",
    "type": "remote",
    "buildInfo": { "buildVersion": "def5678", "buildName": "store" },
    "remoteEntry": {
      "name": "store.container.js",
      "path": "",
