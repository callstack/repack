    },
    {
      "name": "zustand",
      "version": "5.0.3",
      "singleton": true,
      "eager": false,
      "requiredVersion": "^5.0.0"
    }
  ],
  "remotes": [],
  "exposes": [
    { "id": "store:Button", "name": "Button", "path": "./src/Button" }
  ],
