{
  "name": "tester-expo-widget",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "repack:start": "react-native webpack-start",
    "repack:start:remote": "react-native webpack-start --port 8082",
    "repack:ios": "expo run:ios --no-bundler",
    "repack:android": "expo run:android --no-bundler",
    "repack:build:production": "pnpm run repack:build:production:ios && pnpm run repack:build:production:android",
    "repack:build:production:ios": "node ./scripts/build-production.mjs ios",
    "repack:build:production:android": "node ./scripts/build-production.mjs android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@callstack/repack": "workspace:*",
    "@callstack/repack-expo": "workspace:*",
    "@module-federation/enhanced": "catalog:expo57",
    "expo": "catalog:expo57",
    "expo-asset": "catalog:expo57",
    "expo-constants": "catalog:expo57",
    "expo-font": "catalog:expo57",
    "react": "catalog:expo57",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@react-native-community/cli": "catalog:expo57",
    "@react-native-community/cli-platform-android": "catalog:expo57",
    "@react-native-community/cli-platform-ios": "catalog:expo57",
    "@react-native/babel-preset": "catalog:testers",
    "@react-native/community-cli-plugin": "catalog:expo57",
    "@rspack/core": "catalog:",
    "@types/react": "catalog:expo57",
    "babel-preset-expo": "catalog:expo57",
    "typescript": "catalog:"
  }
}
